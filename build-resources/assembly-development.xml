<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
  <id>development</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}</directory>
      <includes>
        <include>README.md</include>
        <include>LICENSE</include>
        <include>code/*.lua</include>
        <include>code/spellmap/*.lua</include>
        <include>code/spellmap/base/*.lua</include>
        <include>code/spellmap/overlay/*.lua</include>
        <include>gui/*.lua</include>
        <include>gui/*.xml</include>
        <include>test/*.lua</include>
        <include>test/framework/*.lua</include>
        <include>test/framework/*.xml</include>
        <include>test/category/*.lua</include>
        <include>test/debug/*.lua</include>
        <include>test/debug/*.xml</include>
        <include>dev/*.lua</include>
        <include>assets/*.blp</include>
        <include>assets/*.tga</include>
        <include>localization/*.lua</include>
        <include>docs/TEST.md</include>
        <include>docs/DEVELOPMENT.md</include>
      </includes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>build-resources/cooldownwatch-development.toc.tpl</source>
      <outputDirectory>./</outputDirectory>
      <filtered>true</filtered>
      <destName>CooldownWatch.toc</destName>
    </file>
  </files>
</assembly>
